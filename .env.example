# Generated local-only credentials. setup_windows.bat creates .env for you.
FREQTRADE__API_SERVER__USERNAME=autotrade
FREQTRADE__API_SERVER__PASSWORD=replace-with-random-value
FREQTRADE__API_SERVER__JWT_SECRET_KEY=replace-with-at-least-32-random-characters
FREQTRADE__API_SERVER__WS_TOKEN=replace-with-random-value
# Optional in dry-run. Store only here, never in user_data/config.json.
FREQTRADE__EXCHANGE__KEY=replace-with-gate-key
FREQTRADE__EXCHANGE__SECRET=replace-with-gate-secret
